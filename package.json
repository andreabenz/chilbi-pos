{
  "name": "ceviwie-chilbi",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "dev:butler": "pnpm --filter ceviwie-chilbi-butler dev",
    "dev:pos": "concurrently \"pnpm --filter @ceviwie/chilbi-shared build && pnpm --filter ceviwie-chilbi-pos dev\" \"sleep 5; pnpm --filter @ceviwie/chilbi-shared dev\"",
    "dev:shared": "pnpm --filter @ceviwie/chilbi-shared dev",
    "build:butler": "pnpm run build:shared && pnpm --filter ceviwie-chilbi-butler build",
    "build:pos": "pnpm run build:shared && pnpm --filter ceviwie-chilbi-pos build",
    "build:all": "pnpm run build:shared && pnpm -r --if-present build",
    "build:shared": "pnpm --filter @ceviwie/chilbi-shared build",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix ."
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^39.2.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.0",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.4.0",
    "vue-eslint-parser": "^10.2.0"
  },
  "dependencies": {
    "@ceviwie/chilbi-shared": "workspace:*"
  },
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c"
}
